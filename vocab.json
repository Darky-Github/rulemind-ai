        ["tell", "me", "about", "you"]
      ],
      "responses": [
        "I'm RuleMind, a rule-based conversational system. My behavior comes from structured vocabulary, normalization, intent rules, and response selection.",
        "RuleMind is designed to create complex conversational behavior from deterministic rules and data."
      ]
    },

    {
      "id": "COMPLIMENT",
      "priority": 15,
      "patterns": [
        ["you", "are", "smart"],
        ["you", "are", "good"],
        ["you", "are", "awesome"],
        ["you", "are", "great"],
        ["nice", "ai"],
        ["good", "job"]
      ],
      "responses": [
