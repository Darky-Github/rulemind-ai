      "responses": [
        "Goodbye.",
        "See you later.",
        "Take care.",
        "Until next time."
      ]
    },

    {
      "id": "THANKS",
      "priority": 25,
      "patterns": [
        ["thanks"],
        ["thank", "you"],
        ["thank", "you", "so", "much"],
        ["thanks", "a", "lot"],
        ["much", "appreciated"],
        ["i", "appreciate", "it"]
      ],
      "responses": [
        "You're welcome.",
        "No problem.",
        "Anytime.",
        "Glad I could help."
      ]
    },

    {
      "id": "IDENTITY",
      "priority": 25,
      "patterns": [
        ["who", "are", "you"],
        ["what", "are", "you"],
        ["what", "is", "your", "name"],
        ["what", "is", "your", "identity"],
        ["introduce", "yourself"]
      ],
      "responses": [
        "I'm RuleMind, a rule-based conversational AI.",
        "I'm RuleMind. I process language using rules, vocabulary, normalization, and context.",
        "I'm RuleMind, a deterministic conversational engine."
      ]
    },

    {
      "id": "CAPABILITIES",
      "priority": 25,
      "patterns": [
        ["what", "can", "you", "do"],
        ["what", "do", "you", "do"],
        ["what", "are", "your", "capabilities"],
        ["what", "are", "you", "capable", "of"],
        ["what", "can", "i", "ask", "you"]
      ],
      "responses": [
        "I can process conversational input, normalize slang and typos, detect intents, apply rules, maintain basic context, and respond using the loaded knowledge base.",
        "My behavior is driven by rules and data. I can recognize patterns, normalize different forms of language, and select responses based on detected intent."
      ]
    },

    {
      "id": "HELP",
      "priority": 25,
      "patterns": [
