        ["i", "need", "help"],
        ["can", "you", "help", "me"],
        ["could", "you", "help", "me"]
      ],
      "responses": [
        "Sure. Tell me what you need help with.",
        "What do you need help with?",
        "Describe the problem and I'll see which rules apply."
      ]
    },

