  "intents": [
    {
      "id": "GREETING",
      "priority": 10,
      "patterns": [
        ["hello"],
        ["hi"],
        ["hey"],
        ["greetings"],
        ["good", "morning"],
        ["good", "afternoon"],
        ["good", "evening"],
        ["howdy"]
      ],
      "responses": [
        "Hello.",
        "Hi. How can I help?",
        "Hey. What can I do for you?",
        "Hello there."
      ]
    },

    {
      "id": "GREETING_STATUS",
      "priority": 30,
      "patterns": [
        ["how", "are", "you"],
        ["how", "are", "you", "doing"],
        ["how", "have", "you", "been"],
        ["how", "is", "it", "going"],
