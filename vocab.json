        ["you", "good"],
        ["you", "okay"],
        ["everything", "good"],
        ["everything", "okay"]
      ],
      "responses": [
        "I'm doing well. What can I help you with?",
        "I'm doing great. What are we working on?",
        "Everything is running normally.",
        "I'm good. Ready for your next question."
      ]
    },

    {
